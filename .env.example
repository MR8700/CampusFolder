# Campus Folder - Environment Variables Configuration

# 1. Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3005
PORT=3005

# 2. Database (PostgreSQL - Production Vercel / Neon / Supabase / Vercel Postgres)
# URL avec pooler (pour serverless / requêtes Next.js) :
DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/campusfolder?sslmode=require&pgbouncer=true"

# URL directe (pour les migrations Prisma et prisma db push) :
DIRECT_URL="postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/campusfolder?sslmode=require"

# 3. Email Notification Configuration (Production SMTP or Gmail)
# Optional: If omitted, Campus Folder uses the robust local audit & simulation engine
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-adresse@gmail.com
# SMTP_PASS=votre-mot-de-passe-d-application
# SMTP_FROM="Campus Folder Officiel" <notifications@campusfolder.bf>

# Or for direct Gmail:
# GMAIL_USER=votre-adresse@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 4. Real-time Communication, Redis & WebSockets
# Optional: In development, Campus Folder uses internal EventBus & SSE. In scaled multi-instances, provide Redis URL.
# REDIS_URL="redis://default:password@eu-central-1.upstash.io:6379"
# WEBSOCKET_URL="wss://realtime.campusfolder.bf"
# WEBRTC_SIGNALING_URL="https://signaling.campusfolder.bf"

# 5. Scalable SFU Media Server Cluster (LiveKit / Mediasoup)
SFU_URL="https://sfu.campusfolder.bf"
SFU_API_KEY="cf_sfu_cluster_key_sample"
SFU_API_SECRET="cf_sfu_cluster_secret_sample"

# 6. Object Storage (S3 / MinIO / Cloudflare R2 for large media & recordings)
# OBJECT_STORAGE_ENDPOINT="https://s3.eu-central-1.wasabisys.com"
# OBJECT_STORAGE_BUCKET="campusfolder-pedagogic-media"
# OBJECT_STORAGE_ACCESS_KEY="SAMPLE_KEY"
# OBJECT_STORAGE_SECRET_KEY="SAMPLE_SECRET"

