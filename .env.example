# Campus Folder - Environment Variables Configuration

# 1. Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3005
PORT=3005

# 2. Database (PostgreSQL - Production Vercel / Neon / Supabase / Vercel Postgres)
# URL avec pooler (pour serverless / requêtes Next.js) :
DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/campusfolder?sslmode=require&pgbouncer=true"

# URL directe (pour les migrations Prisma et prisma db push) :
DIRECT_URL="postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/campusfolder?sslmode=require"

# 3. Email Notification Configuration (Production SMTP or Gmail)
# Optional: If omitted, Campus Folder uses the robust local audit & simulation engine
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre-adresse@gmail.com
# SMTP_PASS=votre-mot-de-passe-d-application
# SMTP_FROM="Campus Folder Officiel" <notifications@campusfolder.bf>

# Or for direct Gmail:
# GMAIL_USER=votre-adresse@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
